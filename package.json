{
  "name": "tdc-conference-displays",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "playwright test --project=behavior tests/api.spec.ts",
    "preview:production": "npm run build && node scripts/serve-production.mjs",
    "test:production": "playwright test --project=production",
    "smoke:sessionize": "node scripts/sessionize-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.0"
  }
}
